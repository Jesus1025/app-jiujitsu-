{
  "expo": {
    "name": "App Jiu-Jitsu",
    "slug": "app-jiujitsu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appjiujitsu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "cl.appjiujitsu.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F4E9C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cl.appjiujitsu.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F4E9C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para escanear el QR de asistencia y tomar la foto de la ficha.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para la foto de la ficha del alumno.",
          "cameraPermission": "La app usa la cámara para tomar la foto de la ficha del alumno."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F4E9C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
